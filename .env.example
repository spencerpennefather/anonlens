# AnonLens — environment variables. Copy to .env.local. Never reuse another clone's values.

# Public site URL (canonical URLs, sitemap, Open Graph). Defaults to https://anonlens.com
NEXT_PUBLIC_SITE_URL=https://anonlens.com

# --- Story/profile retrieval (use a separate HikerAPI account/key per clone) ---
HIKERAPI_KEY=
HIKERAPI_Fallback_1_KEY=
HIKERAPI_Fallback_2_KEY=
HIKERAPI_Fallback_3_KEY=
SCRAPFLY_API_KEY=

# --- Redis (own Upstash database per clone; also stores admin-managed keys + featured profiles) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
FEATURED_PROFILES_CACHE_TTL_HOURS=120

# --- Admin dashboard (/admin/hikerapi) — choose unique credentials ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Cloudflare Turnstile (own site key per clone) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional third-party tags (omit = not loaded) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AHREFS_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_AHREFS_VERIFICATION=
